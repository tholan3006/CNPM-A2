@startuml activity-detail
' Đồ án: Công nghệ Phần mềm - ĐH Sài Gòn (SGU)
' Thành viên 2: Màn hình & Luồng "Chi tiết sản phẩm"
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam backgroundColor #FFFFFF

skinparam activity {
    BorderColor #1E293B
    BackgroundColor #FFFFFF
    ArrowColor #334155
}

skinparam swimlane {
    BorderColor #94A3B8
    TitleFontColor #0F172A
}

title Sơ đồ Hoạt động (Activity Diagram) – Luồng Xem Chi Tiết, Chọn Size & Topping, Tính Giá Tự Động

|Khách hàng (Customer)|
|Frontend (Next.js Modal)|
|Backend API (NestJS)|
|Database (PostgreSQL)|

|Khách hàng (Customer)|
start
:Nhấp chọn 1 món đồ uống từ màn hình Menu;

|Frontend (Next.js Modal)|
:Mở ProductDetailModal ở trạng thái nạp dữ liệu (Skeleton Modal);
:Gửi HTTP request GET /products/:id;

|Backend API (NestJS)|
:Tiếp nhận request GET /products/:id;
:Kiểm tra tính hợp lệ của Product ID (UUID / Numeric);

|Database (PostgreSQL)|
:Thực thi truy vấn SELECT sản phẩm, quan hệ Sizes và Toppings khả dụng;
note right
  SELECT p.*, s.*, t.* 
  FROM products p 
  LEFT JOIN product_sizes s ON s.product_id = p.id
  LEFT JOIN product_toppings pt ON pt.product_id = p.id
  LEFT JOIN toppings t ON t.id = pt.topping_id AND t.is_active = true
  WHERE p.id = :id;
end note

if (Tìm thấy sản phẩm?) then (Có)
    :Trả về record Sản phẩm kèm danh sách Options;
    |Backend API (NestJS)|
    :Đóng gói dữ liệu thành ProductDetailResponseDto;
    :Trả về HTTP 200 OK kèm payload JSON;
    |Frontend (Next.js Modal)|
    :Ẩn Skeleton, lưu thông tin sản phẩm vào Local State;
    :Thiết lập giá trị mặc định:\n- Size: Size M (Phụ thu: 0đ)\n- Toppings: Trống []\n- Số lượng: 1\n- Tính toán Giá ban đầu = Giá gốc;
    :Render giao diện Modal Chi tiết Sản phẩm;
else (Không tìm thấy / Sản phẩm ngừng bán)
    |Database (PostgreSQL)|
    :Không có bản ghi phù hợp;
    |Backend API (NestJS)|
    :Trả về HTTP 404 Not Found (Product not found);
    |Frontend (Next.js Modal)|
    :Hiển thị Toast báo lỗi: "Sản phẩm không tồn tại hoặc đã ngừng phục vụ";
    :Tự động đóng Modal chi tiết;
    |Khách hàng (Customer)|
    :Tiếp tục duyệt danh sách menu;
    stop
endif

|Khách hàng (Customer)|
:Quan sát hình ảnh, tên món, mô tả và giá gốc;

repeat
    if (Khách hàng thực hiện thao tác tùy chỉnh?) then (Chọn kích cỡ Size)
        |Khách hàng (Customer)|
        :Bấm chọn Size (Size S / Size M / Size L);
        |Frontend (Next.js Modal)|
        :Cập nhật state selectedSize = size;\nLấy extraPrice tương ứng (S: -5k/0k, M: 0k, L: +10k);
        
    else if (Chọn hoặc bỏ chọn Topping) then (Tùy chọn Topping)
        |Khách hàng (Customer)|
        :Tick chọn / bỏ tick loại Topping mong muốn;
        |Frontend (Next.js Modal)|
        if (Topping còn hàng trong kho?) then (Còn hàng)
            :Cập nhật state selectedToppings (thêm hoặc loại bỏ toppingId);
        else (Hết hàng)
            :Hiển thị nhãn "Hết hàng" mờ xám;\nChặn thao tác tick chọn;
        endif

    else if (Tùy chỉnh Đường / Đá) then (Mức Đường & Đá)
        |Khách hàng (Customer)|
        :Chọn mức đường (100%, 70%, 50%, 30%, Không đường)\nvà mức đá (100%, 70%, 50%, Đá riêng, Không đá);
        |Frontend (Next.js Modal)|
        :Cập nhật state selectedSweetness & selectedIce;

    else (Thay đổi Số lượng món)
        |Khách hàng (Customer)|
        :Nhấn nút [+] tăng hoặc [-] giảm số lượng;
        |Frontend (Next.js Modal)|
        if (Số lượng mới >= 1 và <= Giới hạn tồn kho) then (Hợp lệ)
            :Cập nhật state quantity = newQuantity;
        else (Vượt giới hạn)
            :Cảnh báo số lượng không vượt quá giới hạn cho phép;
        endif
    endif

    |Frontend (Next.js Modal)|
    :Kích hoạt hàm tính toán giá động (calculateTotalPrice());
    note right
      <b>Hàm tính giá Client tức thời:</b>
      unitPrice = basePrice + sizeExtraPrice + sum(selectedToppingPrices)
      totalPrice = unitPrice * quantity
    end note
    :Cập nhật nhãn hiển thị tổng tiền thời gian thực trên nút "Thêm vào giỏ hàng";
    :Hiển thị chi tiết diễn giải phép tính (Breakdown Pricing);

|Khách hàng (Customer)|
repeat while (Tiếp tục thay đổi tùy chọn?) is (Tiếp tục đổi)
-> (Hài lòng với tùy chọn đã chọn);

|Khách hàng (Customer)|
:Nhấn nút "Thêm vào giỏ hàng" kèm tổng tiền đã tính;

|Frontend (Next.js Modal)|
:Đóng gói Item payload:\n{ productId, name, size, toppings, sweetness, ice, quantity, totalPrice, image };
:Thêm Item vào Zustand Cart Store / LocalStorage;
:Hiển thị thông báo Toast: "Đã thêm món vào giỏ hàng thành công!";
:Cập nhật Badge số lượng trên biểu tượng Giỏ hàng thanh Header;
:Đóng Modal Chi tiết Sản phẩm;

|Khách hàng (Customer)|
:Tiếp tục chọn món khác hoặc bấm xem Giỏ hàng để thanh toán;
stop

@enduml
