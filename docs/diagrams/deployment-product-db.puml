@startuml deployment-product-db
' Đồ án: Công nghệ Phần mềm - ĐH Sài Gòn (SGU)
' Thành viên 2: Màn hình & Luồng "Chi tiết sản phẩm"
!theme plain
skinparam shadowing false
skinparam defaultFontName Arial
skinparam roundcorner 6

title Sơ đồ Triển khai (Deployment Diagram) – Cấu Trúc Lưu Trữ Dữ Liệu Sản Phẩm & Tùy Chọn trong PostgreSQL

node "Khách hàng & Trình duyệt\n<<device: Client Device>>" as ClientNode {
    artifact "BrewLite Next.js Web Client\n[ProductDetailModal, priceCalculator]" as WebApp
}

node "Máy chủ Ứng dụng & Triển khai\n<<platform: Docker Host Server (Linux / Ubuntu 22.04)>>" as DockerHost {

    node "Container: brewlite-web\n<<Next.js 14 Web Server>>" as WebContainer {
        component "Next.js SSR & API Route Proxy\n[Port: 3000]" as WebService
    }

    node "Container: brewlite-api\n<<NestJS 10 Framework>>" as ApiContainer {
        component "ProductsController\n[GET /products/:id]" as ProdCtrl
        component "ProductsService\n[Business Logic & Format DTO]" as ProdSvc
        component "Prisma ORM Client\n[Connection Pooler: max 10 conn]" as PrismaClient
    }

    node "Container: brewlite-db\n<<container: PostgreSQL 16 Alpine>>" as DbContainer {
        
        node "<<execution environment>> PostgreSQL Engine (Daemon Process)" as PgEngine {
            component "Connection Handler\n[Port 5432 - TCP Socket]" as ConnHandler
            component "Query Parser & Planner\n[Cost-based Optimizer]" as QueryPlanner
            component "Shared Buffer Pool & Memory Cache\n[shared_buffers: 256MB]" as SharedMem
            component "Write-Ahead Logging Engine\n[WAL Buffer & Checkpointer]" as WALEngine
        }

        database "Database: brewlite_db\n<<RDBMS Schema: public>>" as PgDatabase {
            
            frame "Bảng Dữ liệu Sản phẩm & Danh mục" {
                folder "Table: categories" as tbl_cat {
                    file "PK: id (UUID)\nname VARCHAR(100)\nslug VARCHAR(100) UNIQUE\nis_active BOOLEAN"
                }
                folder "Table: products" as tbl_prod {
                    file "PK: id (UUID)\nFK: category_id (UUID)\nname VARCHAR(150)\nbase_price NUMERIC(12,2)\ndescription TEXT\nimage_url VARCHAR(255)\nstock INTEGER\nis_active BOOLEAN"
                }
            }

            frame "Bảng Tùy chọn Kích cỡ & Topping" {
                folder "Table: product_sizes" as tbl_sizes {
                    file "PK: id (UUID)\nFK: product_id (UUID)\nsize_code VARCHAR(10) [S,M,L]\nname VARCHAR(50)\nextra_price NUMERIC(10,2)\nis_default BOOLEAN\nis_available BOOLEAN"
                }
                folder "Table: toppings" as tbl_toppings {
                    file "PK: id (UUID)\nname VARCHAR(100)\nprice NUMERIC(10,2)\nstock INTEGER\nis_active BOOLEAN"
                }
                folder "Table: product_toppings (Liên kết N:N)" as tbl_prod_toppings {
                    file "PK, FK: product_id (UUID)\nPK, FK: topping_id (UUID)\nis_default BOOLEAN"
                }
            }

            frame "Chỉ mục Tối ưu Truy vấn (B-Tree Indexes)" {
                file "idx_products_category ON products(category_id)" as idx_prod_cat
                file "idx_products_active ON products(is_active)" as idx_prod_act
                file "idx_sizes_product ON product_sizes(product_id)" as idx_sizes_prod
                file "idx_toppings_active ON toppings(is_active)" as idx_top_act
                file "idx_prod_toppings_pid ON product_toppings(product_id)" as idx_pt_pid
            }
        }
    }

    storage "Persistent Storage Volume\n<<docker volume: brewlite_pgdata>>" as DiskStorage {
        folder "/var/lib/postgresql/data" {
            file "base/ (Data Blocks & Tablespaces)"
            file "pg_wal/ (Write-Ahead Logs)"
            file "global/ (System Catalogs)"
        }
    }
}

' Liên kết và luồng truy xuất dữ liệu
WebApp --> WebService : HTTPS (Port 443 -> 3000)
WebService --> ProdCtrl : HTTP GET /products/:id (Internal Port 4000)
ProdCtrl --> ProdSvc : Call findOne(id)
ProdSvc --> PrismaClient : Query Prisma Client
PrismaClient --> ConnHandler : TCP Connection (Port 5432)
ConnHandler --> QueryPlanner : Parse SQL Query
QueryPlanner --> SharedMem : Lookup in Buffer Cache
SharedMem --> PgDatabase : Read / Write Table Pages
PgDatabase --> DiskStorage : Synchronous Disk I/O (Bền vững dữ liệu)
WALEngine ..> DiskStorage : Append WAL Logs

' Quan hệ Khóa ngoại CSDL
tbl_prod ..> tbl_cat : FK (category_id)
tbl_sizes ..> tbl_prod : FK (product_id CASCADE)
tbl_prod_toppings ..> tbl_prod : FK (product_id CASCADE)
tbl_prod_toppings ..> tbl_toppings : FK (topping_id RESTRICT)

@enduml
