@startuml class-domain
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam roundcorner 6
skinparam shadowing false

title Sơ đồ Lớp Lĩnh vực Hệ thống BrewLite (Domain Class Diagram - Task 2.3)

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum ProductSize {
  S
  M
  L
}

enum PaymentMethod {
  E_WALLET
  BANK_CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

class User {
  + id: String [PK]
  + email: String [Unique]
  + passwordHash: String
  + fullName: String
  + phone: String
  + role: Role
  + loyaltyPoints: Int
  + createdAt: DateTime
  + updatedAt: DateTime
  --
  + verifyPassword(plain: String): Boolean
  + addLoyaltyPoints(pts: Int): void
}

class Product {
  + id: String [PK]
  + name: String
  + description: String
  + price: Decimal
  + imageUrl: String
  + stock: Int
  + version: Int
  + isActive: Boolean
  + createdAt: DateTime
  + updatedAt: DateTime
  --
  + checkAvailability(): Boolean
}

class Order {
  + id: String [PK]
  + orderNumber: String [Unique]
  + userId: String [FK]
  + status: OrderStatus
  + subtotal: Decimal
  + discountAmount: Decimal
  + total: Decimal
  + notes: String
  + createdAt: DateTime
  + updatedAt: DateTime
  --
  + markAsPaid(): void
  + markAsCancelled(): void
}

class OrderItem {
  + id: String [PK]
  + orderId: String [FK]
  + productId: String [FK]
  + size: ProductSize
  + basePrice: Decimal
  + qty: Int
  + lineTotal: Decimal
  --
  + calculateLineTotal(): Decimal
}

class Payment {
  + id: String [PK]
  + orderId: String [FK]
  + idempotencyKey: String [Unique]
  + amount: Decimal
  + method: PaymentMethod
  + status: PaymentStatus
  + transactionRef: String
  + createdAt: DateTime
  --
  + isSuccessful(): Boolean
}

class Promotion {
  + id: String [PK]
  + code: String [Unique]
  + discountPercent: Decimal
  + discountAmount: Decimal
  + minOrderValue: Decimal
  + maxDiscount: Decimal
  + usageLimit: Int
  + usedCount: Int
  + isActive: Boolean
  + expiresAt: DateTime
  --
  + isValid(): Boolean
  + calculateDiscount(orderAmount: Decimal): Decimal
}

class LoyaltyTransaction {
  + id: String [PK]
  + userId: String [FK]
  + orderId: String [FK, Optional]
  + pointsChange: Int
  + reason: String
  + createdAt: DateTime
}

' Relationships & Multiplicity
User "1" *-- "0..*" Order : places >
User "1" *-- "0..*" LoyaltyTransaction : earns/spends >
Order "1" *-- "1..*" OrderItem : contains >
Product "1" <-- "0..*" OrderItem : references <
Order "1" *-- "0..*" Payment : pays with >
Order "0..*" o-- "0..1" Promotion : applies >
Order "0..1" <-- "0..1" LoyaltyTransaction : associated with <

Order --> OrderStatus : has
OrderItem --> ProductSize : size
Payment --> PaymentMethod : method
Payment --> PaymentStatus : status
User --> Role : role

@enduml
