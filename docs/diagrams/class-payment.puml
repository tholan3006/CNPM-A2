@startuml class-payment
skinparam classAttributeIconSize 0

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  E_WALLET
  BANK_CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

class Order {
  + id: String [PK]
  + orderNumber: String [Unique]
  + userId: String [FK]
  + status: OrderStatus
  + subtotal: Decimal
  + discountAmount: Decimal
  + total: Decimal
  + notes: String
  + createdAt: DateTime
  + updatedAt: DateTime
  + markAsPaid(): void
  + markAsFailed(): void
}

class Payment {
  + id: String [PK]
  + orderId: String [FK]
  + idempotencyKey: String [Unique]
  + amount: Decimal
  + method: PaymentMethod
  + status: PaymentStatus
  + transactionRef: String
  + createdAt: DateTime
  + isSuccessful(): Boolean
}

class PaymentsController {
  - paymentsService: PaymentsService
  + createPayment(dto: CreatePaymentDto, idempotencyKey: string, user: any): Promise<any>
  + findByOrder(orderId: string, user: any): Promise<any>
}

class PaymentProcessorService {
  - prisma: PrismaService
  - lifecycle: OrderLifecycleService
  + pay(input: PayInput): Promise<PayResult>
  - replay(existing: Payment, userId: string, orderId: string): PayResult
}

Order "1" *-- "0..*" Payment : payments
Payment --> PaymentMethod : uses
Payment --> PaymentStatus : has
Order --> OrderStatus : has

PaymentsController ..> PaymentProcessorService : delegates
PaymentProcessorService ..> Payment : creates & updates
PaymentProcessorService ..> Order : transitions

@enduml
